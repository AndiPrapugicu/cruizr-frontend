# API Configuration
# Development
VITE_API_URL=http://localhost:3000

# Production (uncomment and update after backend deployment)
# VITE_API_URL=https://your-backend.onrender.com

# Stripe Configuration
# Get your publishable key from: https://dashboard.stripe.com/apikeys
# For testing: use pk_test_... (safe to share)
# For production: use pk_live_... (also safe to share - it's publishable)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
